# 4 API KEYS PER I 4 CERVELLI DIVERSI
# Inserisci le tue chiavi personali. Il progetto usa Node 18+ nativo (zero dipendenze npm esterne).

# 1. Google Gemini Flash (Visionario / Product Champion)
# Ottieni la chiave gratuita su: https://aistudio.google.com/
GEMINI_API_KEY=""

# 2. DeepSeek (Scettico Spietato / Red Teamer)
# Ottieni la chiave su: https://platform.deepseek.com/
DEEPSEEK_API_KEY=""

# 3. Groq (CFO Spietato / Llama 3.3 70B ultra-veloce)
# Ottieni la chiave gratuita su: https://console.groq.com/
GROQ_API_KEY=""

# 4. Agnes AI (Giudice Esecutivo / Final Arbiter)
# Ottieni la chiave su: https://apihub.agnes-ai.com/ o compatible OpenAI endpoint
AGNES_API_KEY=""
# Opzionale se usi un altro endpoint compatibile OpenAI per il Giudice:
# AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"

# PORTA LOCALE (Opzionale, default: 3028)
PORT=3028
